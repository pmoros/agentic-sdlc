# Copy to `.env` (gitignored) and fill in. NEVER commit real secrets.

# LiteLLM admin master key. Generate a long random value, e.g.:
#   printf 'sk-%s\n' "$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-REPLACE_ME_with_a_long_random_string

# Password for the local Postgres that persists spend (any strong value).
POSTGRES_PASSWORD=REPLACE_ME

# Your Anthropic API key (per-token billing account). This is the ONLY place it lives —
# workers get a LiteLLM virtual key instead, so they cannot bill around the $200 cap.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# AWS creds — only needed to enable the non-Anthropic Bedrock lanes later:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
